<View>
  <Image name="image" value="$image" />
  <RectangleLabels name="formula_region" toName="image">
    <Label value="formula" background="#1F77B4" />
    <Label value="formula_number" background="#D62728" />
  </RectangleLabels>
  <TextArea name="formula_latex" toName="image" editable="true" perRegion="true"
            rows="3" maxSubmissions="1" displayMode="region-list"
            placeholder="Optional reviewed LaTeX for formula regions" />
  <TextArea name="equation_number" toName="image" editable="true" perRegion="true"
            rows="1" maxSubmissions="1" displayMode="region-list"
            placeholder="Optional displayed equation number, e.g. (5.37)" />
  <Choices name="formula_layout" toName="image" perRegion="true" choice="single" showInline="true">
    <Choice value="display" />
    <Choice value="inline" />
  </Choices>
</View>
